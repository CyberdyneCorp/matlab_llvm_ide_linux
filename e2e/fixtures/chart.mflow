{
  "schema": "matforge.flowchart",
  "version": "0.2.0",
  "entry": "bang_bang",
  "settings": {
    "kind": "state_chart"
  },
  "flows": [
    {
      "id": "flow_bang_bang",
      "kind": "program",
      "name": "bang_bang",
      "signature": {
        "inputs": [
          "temp",
          "setpoint"
        ],
        "outputs": [
          "heater"
        ]
      },
      "nodes": [
        {
          "id": "off",
          "kind": "state",
          "label": "",
          "ports": {
            "in": [
              {
                "id": "in"
              }
            ],
            "out": [
              {
                "id": "out"
              }
            ]
          },
          "data": {
            "params": {
              "decomposition": "leaf",
              "isInitial": "true"
            },
            "entryAction": "heater = 0"
          },
          "ui": {
            "position": {
              "x": 0.0,
              "y": 0.0
            }
          }
        },
        {
          "id": "on",
          "kind": "state",
          "label": "",
          "ports": {
            "in": [
              {
                "id": "in"
              }
            ],
            "out": [
              {
                "id": "out"
              }
            ]
          },
          "data": {
            "params": {
              "decomposition": "leaf"
            },
            "entryAction": "heater = 1"
          },
          "ui": {
            "position": {
              "x": 0.0,
              "y": 0.0
            }
          }
        }
      ],
      "edges": [
        {
          "id": "t_off_on",
          "kind": "transition",
          "from": {
            "node": "off",
            "port": "out"
          },
          "to": {
            "node": "on",
            "port": "in"
          },
          "label": "tick[temp <= setpoint - delta]",
          "data": {
            "params": {
              "priority": "1"
            }
          }
        },
        {
          "id": "t_on_off",
          "kind": "transition",
          "from": {
            "node": "on",
            "port": "out"
          },
          "to": {
            "node": "off",
            "port": "in"
          },
          "label": "tick[temp >= setpoint + delta]",
          "data": {
            "params": {
              "priority": "1"
            }
          }
        }
      ],
      "symbols": {
        "data": [
          {
            "name": "temp",
            "scope": "input",
            "type": "double",
            "units": "C"
          },
          {
            "name": "setpoint",
            "scope": "input",
            "type": "double",
            "units": "C"
          },
          {
            "name": "heater",
            "scope": "output",
            "type": "double",
            "initial": "0"
          },
          {
            "name": "delta",
            "scope": "local",
            "type": "double",
            "initial": "1.0"
          }
        ],
        "events": [
          {
            "name": "tick",
            "trigger": "rising"
          }
        ]
      }
    }
  ]
}